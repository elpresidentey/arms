{
  "version": 2,
  "framework": "vite",
  "outputDirectory": "frontend/dist",
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/((?!assets/|files/|.*\\.(?:png|jpe?g|svg|gif|webp|ico|woff2?|ttf|eot|js|css|json|map)$).*)",
      "destination": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}